  <worksheets>
    <worksheet name='Chart 1 - Listings Map '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Where Are San Diego&apos;s Airbnb Listings?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='10' italic='true'>Each dot is a neighborhood · color = median price · size = listing supply</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontname='Benton Sans Book' fontsize='10' italic='true'>Coastal neighborhoods (La Jolla, Pacific Beach, Mission Bay) cluster </run>
            <run>Æ&#10;</run>
            <run fontname='Benton Sans Book' fontsize='10' italic='true'>on the west coast and show the largest listing concentration. </run>
            <run>Æ&#10;</run>
            <run fontname='Benton Sans Book' fontsize='10' italic='true'>Median prices range from under $100 inland to $300+ in premium coastal areas</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='listings_clean' name='federated.1pwj0yc0k0sptt1culplc1ewarrl' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1pwj0yc0k0sptt1culplc1ewarrl'>
            <column caption='Neighborhood Median Price' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Calculation_1314748090798080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [neighbourhood] : MEDIAN([price]) }' />
            </column>
            <column caption='Neighborhood Supply' datatype='integer' name='[Calculation_1314748091301891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [neighbourhood] : COUNTD([listing_id]) }' />
            </column>
            <column-instance column='[latitude]' derivation='Avg' name='[avg:latitude:qk]' pivot='key' type='quantitative' />
            <column-instance column='[longitude]' derivation='Avg' name='[avg:longitude:qk]' pivot='key' type='quantitative' />
            <column aggregation='Avg' caption='Latitude' datatype='real' name='[latitude]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
            <column caption='Listing Id' datatype='integer' name='[listing_id]' role='dimension' type='ordinal' />
            <column aggregation='Avg' caption='Longitude' datatype='real' name='[longitude]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
            <column caption='Neighbourhood' datatype='string' name='[neighbourhood]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1314748091301891]' derivation='None' name='[none:Calculation_1314748091301891:qk]' pivot='key' type='quantitative' />
            <column-instance column='[neighbourhood]' derivation='None' name='[none:neighbourhood:nk]' pivot='key' type='nominal' />
            <column caption='Price' datatype='integer' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1314748090798080]' derivation='Sum' name='[sum:Calculation_1314748090798080:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1314748091301891]' derivation='Sum' name='[sum:Calculation_1314748091301891:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091301891:qk]' included-values='in-range'>
            <min>30</min>
          </filter>
          <slices>
            <column>[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091301891:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[avg:longitude:qk]' field-type='quantitative' max='-13010562.596434716' min='-13073475.702395579' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
            <encoding attr='space' class='0' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[avg:latitude:qk]' field-type='quantitative' max='3893746.4981741179' min='3848808.564273525' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[sum:Calculation_1314748090798080:qk]' palette='blue_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='map'>
            <format attr='washout' value='0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
