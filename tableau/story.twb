    <worksheet name='Chart4-Review Volume Forecast'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Monthly Review Volume — Actuals and 6-Month Forecast</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>Navy line: historical reviews · Orange line: 6-month auto.arima forecast</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>The solid line shows actual monthly reviews; the orange line on the right is a 6-month forecast generated in R via auto.arima(). The deep dip in early 2020 reflects COVID&apos;s impact on San Diego tourism, followed by a two-year recovery and stabilization. The forecast extends the recent trend rather than predicting a turning point — review count is a lagged, partial proxy for bookings, since not every booking leaves a review.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='chart4_forecast' name='federated.1tvymno1dddn4j14fd7n80bg2ggj' />
          </datasources>
          <datasource-dependencies datasource='federated.1tvymno1dddn4j14fd7n80bg2ggj'>
            <column-instance column='[type]' derivation='None' name='[none:type:nk]' pivot='key' type='nominal' />
            <column-instance column='[year_month]' derivation='None' name='[none:year_month:qk]' pivot='key' type='quantitative' />
            <column caption='Point Forecast' datatype='real' name='[point_forecast]' role='measure' type='quantitative' />
            <column-instance column='[point_forecast]' derivation='Sum' name='[sum:point_forecast:qk]' pivot='key' type='quantitative' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
            <column caption='Year Month' datatype='date' name='[year_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline0' value='#00000000' />
            <format attr='fill-below' id='refline0' value='#00000000' />
            <format attr='line-visibility' id='refline0' value='on' />
            <format attr='line-pattern-only' id='refline0' value='dashed' />
            <format attr='stroke-color' id='refline0' value='#c9c4ba4b' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:type:nk]' />
            </encodings>
            <reference-line axis-column='[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:year_month:qk]' enable-instant-analytics='true' formula='constant' id='refline0' label='Forecast' label-type='custom' scope='per-table' value='#2025-04-12#' value-column='[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:year_month:qk]' z-order='1' />
          </pane>
        </panes>
        <rows>[federated.1tvymno1dddn4j14fd7n80bg2ggj].[sum:point_forecast:qk]</rows>
        <cols>[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:year_month:qk]</cols>
        <annotations>
          <annotation class='point' id='0' mark-position='1' pullback='12' text-width='180'>
            <formatted-text>
              <run fontcolor='#757575'>Year Month: </run>
              <run bold='true'><![CDATA[<[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:year_month:qk]>]]></run>
              <run>
Model projects ~15K monthly reviews by Mar 2026 — demand trending upward.</run>
            </formatted-text>
            <point>
              <visual-coordinate class='mark'>
                <tuple-reference>
                  <tuple-descriptor>
                    <pane-descriptor>
                      <x-fields>
                        <field>[federated.1tvymno1dddn4j14fd7n80bg2ggj].[none:year_month:qk]</field>
                      </x-fields>
