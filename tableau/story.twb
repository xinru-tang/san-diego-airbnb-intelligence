                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Upper-LEFT </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>High sentiment, moderate price </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>→ Value plays — Look here for under-priced guest-loved areas </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Upper-RIGHT</run>
                    <run>Æ&#10;</run>
