    <worksheet name='Chart 8 - Superhost Price Premium'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Superhost Price Premium</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10'>Do Superhosts actually charge more — and by how much?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#898989' fontname='Benton Sans Book' italic='true'>Superhosts charge a modest premium in San Diego — a median of </run>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' italic='true'>$183/night vs. $157</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' italic='true'> for non-Superhosts (about </run>
            <run bold='true' fontcolor='#898989' fontname='Benton Sans Book' italic='true'>+17%</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' italic='true'>). The gap is real but small.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='listings_clean' name='federated.1pwj0yc0k0sptt1culplc1ewarrl' />
          </datasources>
          <datasource-dependencies datasource='federated.1pwj0yc0k0sptt1culplc1ewarrl'>
            <column caption='Host Type' datatype='string' name='[Calculation_1314748091539460]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [host_is_superhost] = &quot;TRUE&quot; THEN &quot;Superhost&quot;&#13;&#10;ELSEIF [host_is_superhost] = &quot;FALSE&quot; THEN &quot;Non-Superhost&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column caption='Host Is Superhost' datatype='string' name='[host_is_superhost]' role='dimension' type='nominal' />
            <column caption='Listing Id' datatype='integer' name='[listing_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1314748091539460]' derivation='None' name='[none:Calculation_1314748091539460:nk]' pivot='key' type='nominal' />
            <column-instance column='[listing_id]' derivation='None' name='[none:listing_id:ok]' pivot='key' type='ordinal' />
            <column-instance column='[price]' derivation='None' name='[none:price:qk]' pivot='key' type='quantitative' />
            <column caption='Price' datatype='integer' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[price]' derivation='Sum' name='[sum:price:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091539460:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1314748091539460:nk]' member='&quot;Non-Superhost&quot;' />
              <groupfilter function='member' level='[none:Calculation_1314748091539460:nk]' member='&quot;Superhost&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:price:qk]' included-values='in-range'>
            <min>11</min>
            <max>1000</max>
          </filter>
          <slices>
            <column>[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091539460:nk]</column>
            <column>[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:price:qk]</column>
          </slices>
          <aggregation value='false' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091539460:nk]' value='301' />
          </style-rule>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline4' value='#00000000' />
            <format attr='fill-below' id='refline4' value='#00000000' />
            <format attr='line-visibility' id='refline4' value='on' />
            <format attr='line-pattern-only' id='refline4' value='dashed' />
          </style-rule>
          <style-rule element='refboxplot'>
            <format attr='palette' id='refline0' value='bp_blue' />
            <format attr='palette' id='refline1' value='bp_blue' />
            <format attr='palette' id='refline2' value='bp_blue' />
            <format attr='palette' id='refline3' value='bp_blue' />
          </style-rule>
        </style>
        <panes>
          <pane id='8' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:Calculation_1314748091539460:nk]' />
