    <worksheet name='Chart 7 - Room Type Mix'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Room Type Mix in the Top 15 Neighborhoods</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>Share of Entire homes, Private rooms, and others by listing supply</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>Entire homes dominate citywide (~84%), but the mix shifts visibly across neighborhoods. Private rooms hold a larger share in inland and budget-tier areas, while top coastal markets like La Jolla and Pacific Beach skew almost entirely toward whole-property rentals — consistent with their role as vacation destinations.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='listings_clean' name='federated.1pwj0yc0k0sptt1culplc1ewarrl' />
          </datasources>
          <datasource-dependencies datasource='federated.1pwj0yc0k0sptt1culplc1ewarrl'>
            <column caption='Listing Id' datatype='integer' name='[listing_id]' role='dimension' type='ordinal' />
            <column caption='Neighbourhood' datatype='string' name='[neighbourhood]' role='dimension' type='nominal' />
            <column-instance column='[neighbourhood]' derivation='None' name='[none:neighbourhood:nk]' pivot='key' type='nominal' />
            <column-instance column='[room_type]' derivation='None' name='[none:room_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[listing_id]' derivation='CountD' name='[pcto:ctd:listing_id:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[room_type]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Room Type' datatype='string' name='[room_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:neighbourhood:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNTD([listing_id])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:neighbourhood:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:neighbourhood:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[pcto:ctd:listing_id:qk:4]' scope='cols' value='% of Distinct Listings' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='height' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:neighbourhood:nk]' value='22' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[pcto:ctd:listing_id:qk:4]' value='p0%' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:room_type:nk]' />
