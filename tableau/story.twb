    <worksheet name='Chart5-Guest Sentiment by Neighborhood (Top &amp; Bottom 10）'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Sentiment by Neighborhood</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>Top 10 most-loved and bottom 10 least-loved areas</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10' italic='true'>The top-rated neighborhoods are typically smaller, residential areas (often inland) where hosts deliver a more personal experience. Bottom-rated areas cluster in high-volume tourist zones like Gaslamp Quarter and the Core, where management is more transactional.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sentiment_by_neighbourhood' name='federated.1xao3r61xxr5eh1fojicv1v0nkcw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Constant' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xao3r61xxr5eh1fojicv1v0nkcw'>
            <column caption='Top + Bottom 10' datatype='string' name='[Calculation_1595192346263552]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RANK(SUM([avg_sentiment]), &apos;desc&apos;) &lt;= 10 &#10;   OR RANK(SUM([avg_sentiment]), &apos;asc&apos;) &lt;= 10 &#10;THEN &apos;Show&apos; &#10;ELSE &apos;Hide&apos; &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sentiment Group' datatype='string' name='[Calculation_4055556991553537]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RANK(SUM([avg_sentiment]), &apos;desc&apos;) &lt;= 10&#13;&#10;THEN &apos;Top 10 — Most Loved&apos;&#13;&#10;ELSE &apos;Bottom 10 — Least Loved&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Sentiment' datatype='real' name='[avg_sentiment]' role='measure' type='quantitative' />
            <column caption='Neighbourhood' datatype='string' name='[neighbourhood]' role='dimension' type='nominal' />
            <column-instance column='[neighbourhood]' derivation='None' name='[none:neighbourhood:nk]' pivot='key' type='nominal' />
            <column-instance column='[avg_sentiment]' derivation='Sum' name='[sum:avg_sentiment:qk]' pivot='key' type='quantitative' />
