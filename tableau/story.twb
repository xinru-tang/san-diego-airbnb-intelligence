              <lod column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[none:listing_id:ok]' />
              <color column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[:Measure Names]' />
            </encodings>
            <reference-line axis-column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[sum:price:qk]' boxplot-mark-exclusion='true' boxplot-whisker-type='standard' enable-instant-analytics='true' formula='average' id='refline3' label-type='automatic' probability='95' scope='per-cell' symmetric='false' value-column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[sum:price:qk]' z-order='1' />
            <reference-line axis-column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[sum:price:qk]' enable-instant-analytics='true' formula='median' id='refline4' label-type='value' probability='95' scope='per-cell' value-column='[federated.1pwj0yc0k0sptt1culplc1ewarrl].[sum:price:qk]' z-order='2' />
            <style>
